# Server secrets for `supabase secrets set`. Never put these in js/config.js.

SITE_URL=https://like-dealer.com
CORS_ALLOW_ORIGINS=https://like-dealer.com,http://localhost:3000,http://127.0.0.1:3000
# Injected automatically on hosted functions; set locally for `functions serve`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

RETAIL_CURRENCY=USD
PROVIDER_CURRENCY=USD
FX_PROVIDER_TO_RETAIL=1
MARKUP_MULTIPLIER=2
# Optional sheet-compatible JSON: { "ok": true, "data": [ { "ID": "01", ... } ] }
# RETAIL_CATALOGUE_URL=

# Optional JSON map of retail id → SocialPanel24 service id, e.g. {"01":"123"}
# RETAIL_SOCIALPANEL_IDS=

SOCIALPANEL24_API_KEY=
SOCIALPANEL24_TIMEOUT_MS=8000
SOCIALPANEL24_ENABLED=true
# test | live — test-mode Stripe events never call a live provider
PROVIDER_ENV=test

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

RESEND_API_KEY=re_...
FROM_EMAIL=orders@solon.agency
FROM_NAME=LikeDealer
REPLY_TO_EMAIL=support@like-dealer.com
OWNER_EMAIL=owner@like-dealer.com
SUPPORT_EMAIL=support@like-dealer.com

WORKER_SECRET=generate-a-long-random-string
ORDER_ID_PREFIX=LD-
APP_FUNCTIONS_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1

# Alternative to `supabase secrets set`: the same keys can live in
# public.app_secrets (RLS on, no anon/authenticated grants). Deno.env wins.

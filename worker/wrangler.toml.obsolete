name = "likedealer-api"
main = "src/index.js"
compatibility_date = "2026-01-01"

[vars]
SITE_URL = "https://like-dealer.com"
MARKUP_MULTIPLIER = "2"
SOCIAL_PANEL_API_URL = "https://socialpanel24.com/api/v2"
ORDERS_API_URL = "OBSOLETE_DO_NOT_CALL"
FROM_NAME = "LikeDealer"

[[kv_namespaces]]
binding = "ORDERS"
id = "REPLACE_WITH_KV_NAMESPACE_ID"
